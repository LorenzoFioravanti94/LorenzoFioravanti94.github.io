---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import brazilPipeline from "../assets/brazil-ecommerce-pipeline.png";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Projects</div>
  </div>

  <div class="mb-10 text-justify">
    A growing collection of data and analytics engineering work. Each project favors an open-source, reproducible stack —
    engineering rigor without vendor lock-in or cloud cost.
  </div>

  <HorizontalCard
    title="Brazilian E-Commerce & Socioeconomic Context"
    img={brazilPipeline}
    desc="An end-to-end analytics engineering pipeline exploring how a Brazilian state's socioeconomic context shapes its e-commerce experience — joining ~100k real Olist orders with public IBGE indicators. Built on a Medallion architecture and delivered as a snowflake dimensional model. Runs entirely on a free, local, open-source stack — no cloud warehouse, fully reproducible end-to-end."
    url="https://github.com/LorenzoFioravanti94/brazil-ecommerce-analytics"
    tech={["dbt Core", "DuckDB", "Dagster", "Python", "SQL", "GitHub Actions"]}
  />
</BaseLayout>
